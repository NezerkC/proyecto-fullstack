# Environment variables for Sonido Vivo Full Stack (Docker Desktop Local)
SERVER_PORT=8080
BACKEND_HOST_PORT=8080
ORACLE_IMAGE=container-registry.oracle.com/database/free:latest

# Seed credentials & Application Users
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VENDEDOR_USERNAME=vendedor
VENDEDOR_PASSWORD=vendedor123
CLIENTE_USERNAME=usuario
CLIENTE_PASSWORD=usuario123

# Databases
MONGO_URI=mongodb://mongodb:27017/sonido_vivo_nosql
ORACLE_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1
ORACLE_USER=sonido_vivo
ORACLE_PASS=secret

# HikariCP Connection Pool
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_VALIDATION_TIMEOUT=5000
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_INIT_FAIL_TIMEOUT=60000

# Security & CORS
JWT_SECRET=SonidoVivoSecretKey2026SuperSecureTokenVal256Bits
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
