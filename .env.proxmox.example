# Proxmox CT100 Environment Configuration (Hermes & Dokploy Architectures)
# Notice: Safe placeholders only. Replace CHANGE_ME with real secrets in your private .env.proxmox file.

# -----------------------------------------------------------------------------
# Deployment Image & Host Port
# -----------------------------------------------------------------------------
# Used by docker-compose.swarm.yml for pre-built image deployments:
BACKEND_IMAGE=sonidovivo-backend:latest
BACKEND_HOST_PORT=8085
JAVA_OPTS=-XX:+UseContainerSupport -Xmx320m -Xms128m

# -----------------------------------------------------------------------------
# Seed Credentials & Application Users
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
VENDEDOR_USERNAME=vendedor
VENDEDOR_PASSWORD=CHANGE_ME
CLIENTE_USERNAME=usuario
CLIENTE_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Shared Database Connections (Choose mode based on deployment target)
# -----------------------------------------------------------------------------
# Mode A: Standalone Docker Compose (docker-compose.proxmox.yml)
# Connects via external bridge network 'hermes_net' using container DNS names:
# MONGO_URI=mongodb://admin:CHANGE_ME@mongodb-sonidovivo:27017/sonido_vivo_nosql?authSource=admin
# ORACLE_URL=jdbc:oracle:thin:@oracle-23ai-sonidovivo:1521/FREEPDB1

# Mode B: Docker Swarm Stack (docker-compose.swarm.yml via Dokploy overlay 'dokploy-network')
# Direct host routing to CT100 published ports (192.168.3.150):
MONGO_URI=mongodb://admin:CHANGE_ME@192.168.3.150:27017/sonido_vivo_nosql?authSource=admin
ORACLE_URL=jdbc:oracle:thin:@192.168.3.150:1521/FREEPDB1

ORACLE_USER=SONIDO_VIVO
ORACLE_PASS=CHANGE_ME

# -----------------------------------------------------------------------------
# HikariCP Resilience & Sizing for Hermes (512MB RAM constraint)
# -----------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=1
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_VALIDATION_TIMEOUT=5000
HIKARI_INIT_FAIL_TIMEOUT=90000

# -----------------------------------------------------------------------------
# Security & CORS
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_MIN_32_BYTES_JWT_SECRET_KEY
CORS_ALLOWED_ORIGINS=http://192.168.3.150:5173,http://192.168.3.150,http://localhost:5173
